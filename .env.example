# .env.example - Laravel IoT Smart Cat Cage

APP_NAME="IoT Smart Cat Cage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# NGROK Configuration
# When using ngrok, update APP_URL to your ngrok URL (e.g., https://abc123.ngrok-free.app)
# and uncomment ASSET_URL below with the same ngrok URL
# For ESP32 CAM deployment, update these values:
APP_URL=https://sensationally-uninflective-porsha.ngrok-free.dev
SESSION_DOMAIN=.ngrok-free.dev
SANCTUM_STATEFUL_DOMAINS=sensationally-uninflective-porsha.ngrok-free.dev
# ASSET_URL=https://sensationally-uninflective-porsha.ngrok-free.dev

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iot_laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Firebase Cloud Messaging (Web Push API with VAPID)
# Note: FCM Legacy API is deprecated. We use Web Push API instead.
# No server key needed! Authentication via VAPID public key in browser.
FCM_PROJECT_ID=iot-laravel-6c139
FIREBASE_API_KEY=AIzaSyCjCKE7SPsDGQudmU3QY3sxmwQsxW9yF6A
FIREBASE_AUTH_DOMAIN=iot-laravel-6c139.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=814456771799
FIREBASE_APP_ID=1:814456771799:web:0b6926f649ab9a5279cc92
FIREBASE_VAPID_PUBLIC=BBo00ecklx75r4leDlsDfl3_WQ7X4y8Msv5m9AJ4SwH27UCGUiaHDyBesw7U48A6wRCWtNWZP_gSOxzIeLerMOU
FIREBASE_STORAGE_BUCKET=iot-laravel-6c139.firebasestorage.app


# MQTT Configuration (HiveMQ Cloud Serverless)
MQTT_HOST=3ccfdf64ce1f497db3a40c9b37fe1624.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_CLIENT_ID=laravel-iot-catcage

MQTT_AUTH_USERNAME=mizaell
MQTT_AUTH_PASSWORD=Miegoreng1-

MQTT_CLEAN_SESSION=true
MQTT_KEEPALIVE=60
MQTT_CONNECTION_TIMEOUT=5
MQTT_TOPIC_PREFIX=iot/devices
MQTT_QOS=1
MQTT_LOGGING_ENABLED=true

# TLS
MQTT_TLS_ENABLED=true
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_CA_FILE=storage/certs/hivemq-ca.pem

# ESP32 Camera Configuration
ESP32_API_KEY=supersecretkey123

VITE_APP_NAME="${APP_NAME}"
